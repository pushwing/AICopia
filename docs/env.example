# ─── 보안 설정 ───────────────────────────────────────────────────────────────
# 세션 쿠키명: 기본값 'ci_session'은 프레임워크를 노출하므로 변경 권장 (VLN-04)
app.sessionCookieName = _s

# HTTPS 운영 환경에서 Secure 쿠키 강제 (VLN-06) — 운영 서버에서만 true 설정
# app.sessionCookieSecure = true

# ─── PG 결제 연동 환경변수 ─────────────────────────────────────────────────────
# 사용하는 PG만 설정하면 됩니다. (미사용 PG는 주석 처리)
# 실제 .env 또는 서버 환경변수에 설정하세요. 이 파일을 커밋하지 마세요.

# ── 토스페이먼츠 ─────────────────────────────────────────────────────────────
# https://developers.tosspayments.com/my-account/api-keys
#
# ⚠️ 반드시 "API 개별 연동 키"를 쓸 것 — 이 프로젝트는 결제창 SDK를 쓴다.
#    결제창(API 개별 연동): test_ck_ / live_ck_ , test_sk_ / live_sk_   ← 이것
#    결제위젯            : test_gck_ / live_gck_, test_gsk_ / live_gsk_
# 결제위젯 키(gck)를 넣으면 결제창을 열기 전 apigw 검증에서 400이 떨어진다.
TOSS_CLIENT_KEY = test_ck_...
TOSS_SECRET_KEY = test_sk_...

# ── KG이니시스 ───────────────────────────────────────────────────────────────
# https://inilite.inicis.com (테스트: INIpayTest)
INICIS_MERCHANT_ID = INIpayTest
INICIS_SIGN_KEY    = SU5JTElURV9UUklQTEVERVNLRVlfVEVTVA==

# ── 나이스페이먼츠 ───────────────────────────────────────────────────────────
# https://npg.nicepay.co.kr/merchant/login.do
NICEPAY_CLIENT_ID  = S2_...
NICEPAY_SECRET_KEY = ...

# ── 카카오페이 ───────────────────────────────────────────────────────────────
# https://developers.kakaopay.com/docs/payment/online/ready
# 테스트 CID: TC0ONETIME
KAKAOPAY_SECRET_KEY = DEV...
KAKAOPAY_CID        = TC0ONETIME

# ── 네이버페이 ───────────────────────────────────────────────────────────────
# https://developer.pay.naver.com/docs/v2/api
NAVERPAY_CLIENT_ID     = ...
NAVERPAY_CLIENT_SECRET = ...
NAVERPAY_CHAIN_ID      = ...

# ── PAYCO ────────────────────────────────────────────────────────────────────
# https://developers.payco.com
PAYCO_SELLER_KEY = ...
PAYCO_SECRET_KEY = ...

# ── 네이버 쇼핑 검색 API ─────────────────────────────────────────────────────
# https://developers.naver.com/apps/#/register (검색 API 선택)
Naver.clientId     = your_client_id
Naver.clientSecret = your_client_secret

# 관리자 초기 계정 (최초 마이그레이션 시에만 사용)
# 비어 있으면 비밀번호가 랜덤 생성되어 콘솔에 1회 출력된다.
# ADMIN_INITIAL_EMAIL = admin@example.com
# ADMIN_INITIAL_PASSWORD =
